# Upstream WordPress origin. Used by:
#   - middleware.ts        (mobile/tablet Facebook redirect target)
#   - next.config.ts       (rewrites for /wp-content/* and /wp-includes/*, image remotePatterns)
#   - app/[slug]/page.tsx  (title/description/og:image fetch + host masking)
WORDPRESS_ORIGIN=https://kisiselgelisimforum.com

# Public URL of this deployment. Used as metadataBase to absolutize canonical
# and Open Graph URLs. Set this to your production domain in Cloudflare Pages.
SITE_URL=http://localhost:3000

# Optional display name used as og:site_name fallback and in <title> template.
SITE_NAME=Redirect

# Optional. Bypass header for an upstream sitting behind a WAF (e.g. Cloudflare
# Bot Fight Mode) that blocks Worker subrequests. Both must be set together —
# create a matching "Skip" custom WAF rule on the upstream zone that allows
# requests carrying this header+value.
#   Header name examples: X-Proxy-Auth, X-Upstream-Token
#   Value: a long random string you also paste into the WAF rule
UPSTREAM_AUTH_HEADER=
UPSTREAM_AUTH_SECRET=
